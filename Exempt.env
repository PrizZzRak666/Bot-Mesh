# ===== Telegram =====
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ADMIN_ID=123456789

# ===== Language policy =====
DEFAULT_LANG=uk

# ===== OpenAI (optional) =====
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AI_MODEL=gpt-5

# ===== Posting urgent news to channel (optional) =====
NEWS_CHANNEL_ID=@your_channel_username
NEWS_ENABLED=true
NEWS_POLL_SEC=120
NEWS_URGENT_KEYWORDS=терміново,срочно,обстріл,вибух,ракета,дрони,приліт,евакуація,тривога,відбій,удар,ППО
RSS_FEEDS=https://example.com/rss1.xml,https://example.com/rss2.xml

# ===== Official air-raid alerts (optional) =====
UA_ALARM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
UA_ALARM_ENABLED=true
UA_ALARM_POLL_SEC=15

# Если официальный API использует другой заголовок/формат авторизации — меняешь здесь:
UA_ALARM_AUTH_HEADER=Authorization
UA_ALARM_AUTH_PREFIX=
UA_ALARM_BASE=https://api.ukrainealarm.com

# Эндпоинты (на случай отличий в документации/письме):
UA_ALARM_REGIONS_PATH=/api/v3/regions
UA_ALARM_ALERT_PATH_TEMPLATE=/api/v3/alerts/{regionId}

# Названия, по которым ищем нужные regionId:
UA_ALARM_OBLAST_NAME=Одеська область
UA_ALARM_CITY_NAME=Одеса
